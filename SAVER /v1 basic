# ═══════════════════════════════════════════════════════════════════════════
# MODULE GOOGLE BREACH TEST
# ═══════════════════════════════════════════════════════════════════════════

breach_test_google() {
    log_title "Google Breach Test"
    log_info "Vérification des connexions sortantes vers Google..."

    local total=0
    local suspects=0

    if ! have ss && ! have netstat; then
        log_warn "ss et netstat absents — test limité"
    else
        local cmd="ss -tnp"
        have ss || cmd="netstat -tnp"

        local connexions
        connexions=$($cmd 2>/dev/null | grep ESTAB | head -100)

        if [ -z "$connexions" ]; then
            log_ok "Aucune connexion établie détectée"
            return 0
        fi

        while IFS= read -r ligne; do
            total=$((total + 1))
            if echo "$ligne" | grep -qiE "google|goog|gstatic|googleapis|1e100|ggpht|gvt1|youtube"; then
                suspects=$((suspects + 1))
                log_warn "$ligne"
            fi
        done <<< "$connexions"
    fi

    log_sep
    log_info "Total connexions analysées : $total"
    if [ "$suspects" -gt 0 ]; then
        log_warn "$suspects connexion(s) Google détectée(s)"
    else
        log_ok "Aucune connexion Google détectée"
    fi

    log_info "Test DNS Google :"
    if have getent; then
        for h in google.com www.google.com gstatic.com; do
            local r
            r=$(getent hosts "$h" 2>/dev/null | head -1)
            if [ -n "$r" ]; then
                printf "  %-20s %s\n" "$h" "$r"
            else
                printf "  %-20s (non résolu)\n" "$h"
            fi
        done
    fi

    log_info "Test ping Google (3 paquets) :"
    if have ping; then
        ping -c 3 -W 1 google.com 2>/dev/null | tail -3 || log_warn "Ping échoué"
    fi

    log_sep
    log_ok "Breach test terminé"
}

