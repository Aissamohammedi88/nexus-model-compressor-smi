#include <iostream>
#include <cmath>
#include <chrono>
#include <iomanip>

constexpr double E  = $E;
constexpr double PI = $PI;
constexpr long   N  = ${N}L;

double somme_harmonique(double c, long n) {
    double s = 0.0;
    for (long i = 1; i <= n; ++i) s += c / static_cast<double>(i);
    return s;
}

double factorielle(int n) {
    double f = 1.0;
    for (int i = 2; i <= n; ++i) f *= i;
    return f;
}

double fib(int n) {
    double a = 0.0, b = 1.0;
    for (int i = 0; i < n; ++i) { double c = a + b; a = b; b = c; }
    return a;
}

int main() {
    auto t0 = std::chrono::steady_clock::now();
    double s1 = somme_harmonique(E, N);
    double s2 = somme_harmonique(PI, N);
    double p  = E * PI;
    double f  = factorielle(20);
    double fb = fib(90);
    auto t1 = std::chrono::steady_clock::now();
    auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(t1 - t0).count();

    std::cout << std::fixed << std::setprecision(6);
    std::cout << "C++    : n=" << N << "  somme_e=" << s1 << "  somme_pi=" << s2 << "\n";
    std::cout << "         e*pi=" << p << "  20!=" << std::scientific << f << std::fixed
              << "  fib(90)=" << std::setprecision(0) << fb << "\n";
    std::cout << "         temps=" << ms << " ms\n";
    return 0;
}
ENDCPP
