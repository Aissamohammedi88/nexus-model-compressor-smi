# ═══════════════════════════════════════════════════════════════════════════
# MODULE JAVA
# ═══════════════════════════════════════════════════════════════════════════

ecrire_java() {
    local N=$N_ITERATIONS
    local E=$CONSTANTE_E
    local PI=$CONSTANTE_PI

    cat > Calc.java << ENDJAVA
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Instant;

public class Calc {
    private static final double E  = $E;
    private static final double PI = $PI;
    private static final long   N  = ${N}L;

    public static double sommeHarmonique(double c, long n) {
        double s = 0.0;
        for (long i = 1; i <= n; i++) s += c / (double) i;
        return s;
    }

    public static double factorielle(int n) {
        double f = 1.0;
        for (int i = 2; i <= n; i++) f *= i;
        return f;
    }

    public static double fib(int n) {
        double a = 0, b = 1;
        for (int i = 0; i < n; i++) { double c = a + b; a = b; b = c; }
        return a;
    }

    public static void main(String[] args) {
        long t0 = System.currentTimeMillis();
        double s1 = sommeHarmonique(E, N);
        double s2 = sommeHarmonique(PI, N);
        double p  = E * PI;
        double f  = factorielle(20);
        double fb = fib(90);
        long t1 = System.currentTimeMillis();
        System.out.printf("Java   : n=%d  somme_e=%.6f  somme_pi=%.6f%n", N, s1, s2);
        System.out.printf("         e*pi=%.6f  20!=%.2e  fib(90)=%.0f%n", p, f, fb);
        System.out.printf("         temps=%d ms%n", t1 - t0);
    }
}
ENDJAVA
    log_ok "Calc.java écrit"
}

compiler_java() {
    have javac || { log_warn "javac absent"; return 1; }
    javac Calc.java 2>/dev/null || { log_err "Compilation Java échouée"; return 1; }
    log_ok "Compilation Java OK"
}

executer_java() {
    [ -f Calc.class ] || return 1
    java Calc 2>/dev/null
}

# ═══════════════════════════════════════════════════════════════════════════
# MODULE RUST
# ═══════════════════════════════════════════════════════════════════════════

ecrire_rust() {
    local N=$N_ITERATIONS
    local E=$CONSTANTE_E
    local PI=$CONSTANTE_PI

    cat > Cargo.toml << 'ENDTOML'
[package]
name = "nexus_cuda_calc"
version = "4.0.0"
edition = "2021"

[profile.release]
opt-level = 2
lto = true
codegen-units = 1
panic = "abort"
strip = true
ENDTOML

    mkdir -p src
    cat > src/main.rs << ENDRUST
use std::time::Instant;

const E:  f64 = $E;
const PI: f64 = $PI;

fn somme_harmonique(c: f64, n: u64) -> f64 {
    let mut s: f64 = 0.0;
    for i in 1..=n { s += c / (i as f64); }
    s
}

fn factorielle(n: u32) -> f64 {
    let mut f: f64 = 1.0;
    for i in 2..=n { f *= i as f64; }
    f
}

fn fib(n: u32) -> f64 {
    let (mut a, mut b): (f64, f64) = (0.0, 1.0);
    for _ in 0..n { let c = a + b; a = b; b = c; }
    a
}

fn main() {
