have() {
    command -v "$1" >/dev/null 2>&1
}

now_ts()    { date '+%Y-%m-%d %H:%M:%S'; }
now_epoch() { date +%s; }

elapsed_ms() {
    local start=$1
    local end=$2
    echo $(( (end - start) * 1000 ))
}

format_number() {
    local n=$1
    printf "%'.0f" "$n" 2>/dev/null || echo "$n"
}

human_bytes() {
    local b=$1
    if [ "$b" -lt 1024 ]; then
        echo "${b} o"
    elif [ "$b" -lt 1048576 ]; then
        echo "$((b / 1024)) Ko"
    elif [ "$b" -lt 1073741824 ]; then
        echo "$((b / 1048576)) Mo"
    else
        echo "$((b / 1073741824)) Go"
    fi
}

safe_mkdir() {
    local d="$1"
    if [ ! -d "$d" ]; then
        mkdir -p "$d" 2>/dev/null || return 1
    fi
    return 0
}

extract_json_number() {
    local file="$1"
    local key="$2"
    if [ ! -f "$file" ]; then
        echo ""
        return
    fi
    # Extraction simple sans jq
    grep -o "\"$key\"[[:space:]]*:[[:space:]]*[0-9.]*" "$file" 2>/dev/null \
        | head -1 \
        | sed 's/.*:[[:space:]]*//'
}

extract_json_string() {
    local file="$1"
    local key="$2"
    if [ ! -f "$file" ]; then
        echo ""
        return
    fi
    grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$file" 2>/dev/null \
        | head -1 \
        | sed 's/.*:[[:space:]]*"//' \
        | sed 's/"$//'
}

# ═══════════════════════════════════════════════════════════════════════════
# MODULE BATTERIE
# ═══════════════════════════════════════════════════════════════════════════

battery_path() {
    local bat
    bat=$(ls /sys/class/power_supply/ 2>/dev/null | grep -i '^BAT' | head -1)
    if [ -n "$bat" ]; then
        echo "/sys/class/power_supply/$bat"
    fi
}

battery_capacity() {
    local p
    p=$(battery_path)
    if [ -n "$p" ] && [ -r "$p/capacity" ]; then
        cat "$p/capacity" 2>/dev/null
    fi
}

battery_status() {
    local p
    p=$(battery_path)
    if [ -n "$p" ] && [ -r "$p/status" ]; then
        cat "$p/status" 2>/dev/null
    fi
}

battery_voltage() {
    local p
    p=$(battery_path)
    if [ -n "$p" ] && [ -r "$p/voltage_now" ]; then
        local v
        v=$(cat "$p/voltage_now" 2>/dev/null)
        echo $((v / 1000))
    fi
}

battery_current() {
    local p
    p=$(battery_path)
    if [ -n "$p" ] && [ -r "$p/current_now" ]; then
        local c
        c=$(cat "$p/current_now" 2>/dev/null)
        echo $((c / 1000))
    fi
}

battery_health() {
    local p
    p=$(battery_path)
    if [ -n "$p" ] && [ -r "$p/health" ]; then
        cat "$p/health" 2>/dev/null
    fi
}

battery_cycles() {
    local p
    p=$(battery_path)
    if [ -n "$p" ] && [ -r "$p/cycle_count" ]; then
        cat "$p/cycle_count" 2>/dev/null
    fi
}

battery_power_watts() {
    local v c
    v=$(battery_voltage)
    c=$(battery_current)
    if [ -n "$v" ] && [ -n "$c" ] && [ "$v" -gt 0 ]; then
        awk -v v="$v" -v c="$c" 'BEGIN{printf "%.2f", (v*c)/1000000}'
    fi
}

afficher_batterie() {
    local cap sta v c p h cyc
    cap=$(battery_capacity)
    sta=$(battery_status)
    v=$(battery_voltage)
    c=$(battery_current)
    p=$(battery_power_watts)
    h=$(battery_health)
    cyc=$(battery_cycles)

    if [ -z "$cap" ]; then
        log_warn "Batterie introuvable (desktop ou VM)"
        return 1
    fi

    printf "  Capacité : %s%%\n" "$cap"
    printf "  Statut   : %s\n" "${sta:-?}"
    [ -n "$v" ] && printf "  Tension  : %s mV\n" "$v"
    [ -n "$c" ] && printf "  Courant  : %s mA\n" "$c"
    [ -n "$p" ] && printf "  Puissance: %s W\n" "$p"
    [ -n "$h" ] && printf "  Santé    : %s\n" "$h"
    [ -n "$cyc" ] && printf "  Cycles   : %s\n" "$cyc"

    if [ "$cap" -lt "$SEUIL_BATTERIE" ] && [ "$sta" != "Charging" ]; then
        log_warn "Batterie faible (< ${SEUIL_BATTERIE}%)"
        return 2
    fi
    return 0
}

# ═══════════════════════════════════════════════════════════════════════════
# MODULE BATTERY SAVER — Éco / Ultra auto
# ═══════════════════════════════════════════════════════════════════════════

SAVER_STATE_FILE="/tmp/nexus_saver_state_$$"
SAVER_ETAT_PRECEDENT=""

sauvegarder_etat_saver() {
    : > "$SAVER_STATE_FILE"
    local cpu_gov
    cpu_gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "")
    echo "CPU_GOV=$cpu_gov" >> "$SAVER_STATE_FILE"

    local screen_bright
    if have xrandr; then
        screen_bright=$(xrandr --verbose 2>/dev/null | grep -i brightness | head -1 | awk '{print $2}')
    fi
    if [ -n "${screen_bright:-}" ]; then
        echo "BRIGHT=$screen_bright" >> "$SAVER_STATE_FILE"
    fi

    local bt_state
    if have rfkill; then
        bt_state=$(rfkill list bluetooth 2>/dev/null | grep -i "soft blocked" | head -1 | grep -c "yes" || echo "0")
        echo "BT_BLOCKED=$bt_state" >> "$SAVER_STATE_FILE"
    fi

    local wifi_state
    if have rfkill; then
        wifi_state=$(rfkill list wifi 2>/dev/null | grep -i "soft blocked" | head -1 | grep -c "yes" || echo "0")
        echo "WIFI_BLOCKED=$wifi_state" >> "$SAVER_STATE_FILE"
    fi

    SAVER_ETAT_PRECEDENT=$(cat "$SAVER_STATE_FILE" 2>/dev/null)
}

activer_powersave() {
    log_step "Activation mode POWERSAVE"

    if have cpupower; then
        sudo cpupower frequency-set -g powersave >/dev/null 2>&1 && \
            log_ok "CPU governor → powersave" || \
            log_warn "cpupower échoué"
    elif [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        echo powersave | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 && \
            log_ok "CPU governor → powersave (direct)" || \
            log_warn "Écriture governor échouée"
    else
        log_warn "CPU governor non modifiable"
    fi

    if have tlp; then
        sudo tlp bat >/dev/null 2>&1 && log_ok "TLP mode battery" || true
    fi

    if [ -w /sys/class/backlight/*/brightness ]; then
        for bl in /sys/class/backlight/*/brightness; do
            local maxb
            maxb=$(cat "${bl%brightness}max_brightness" 2>/dev/null)
            if [ -n "$maxb" ] && [ "$maxb" -gt 0 ]; then
                local target=$((maxb * 35 / 100))
                echo "$target" | sudo tee "$bl" >/dev/null 2>&1 && \
                    log_ok "Luminosité → 35% ($target/$maxb)" || true
            fi
        done
    fi

    if have rfkill; then
        sudo rfkill block bluetooth 2>/dev/null && log_ok "Bluetooth bloqué" || true
    fi

    return 0
}

restaurer_etat() {
    log_step "Restauration état initial"

    if [ -f "$SAVER_STATE_FILE" ]; then
        local cpu_gov
        cpu_gov=$(grep "^CPU_GOV=" "$SAVER_STATE_FILE" | cut -d= -f2)
        if [ -n "$cpu_gov" ]; then
            if have cpupower; then
                sudo cpupower frequency-set -g "$cpu_gov" >/dev/null 2>&1 || true
            else
                echo "$cpu_gov" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
            fi
            log_ok "CPU governor → $cpu_gov"
        fi

        local bright
        bright=$(grep "^BRIGHT=" "$SAVER_STATE_FILE" | cut -d= -f2)
        if [ -n "$bright" ]; then
            for bl in /sys/class/backlight/*/brightness; do
                echo "$bright" | sudo tee "$bl" >/dev/null 2>&1 || true
            done
            log_ok "Luminosité → $bright"
        fi

        local bt_blocked
        bt_blocked=$(grep "^BT_BLOCKED=" "$SAVER_STATE_FILE" | cut -d= -f2)
        if [ "$bt_blocked" = "0" ] && have rfkill; then
            sudo rfkill unblock bluetooth 2>/dev/null && log_ok "Bluetooth rétabli" || true
        fi

        local wifi_blocked
        wifi_blocked=$(grep "^WIFI_BLOCKED=" "$SAVER_STATE_FILE" | cut -d= -f2)
        if [ "$wifi_blocked" = "0" ] && have rfkill; then
            sudo rfkill unblock wifi 2>/dev/null && log_ok "Wi-Fi rétabli" || true
        fi
    fi

    if have tlp; then
        sudo tlp start >/dev/null 2>&1 || true
    fi

    rm -f "$SAVER_STATE_FILE" 2>/dev/null
    return 0
}

battery_saver_auto() {
    local cap
    cap=$(battery_capacity)
    if [ -z "$cap" ]; then
        return 0
    fi

    if [ "$cap" -lt "$SEUIL_BATTERIE_ULTRA" ]; then
        log_alert "Batterie < ${SEUIL_BATTERIE_ULTRA}% → mode ULTRA"
        sauvegarder_etat_saver
        activer_powersave
        return 2
    elif [ "$cap" -lt "$SEUIL_BATTERIE" ]; then
        log_warn "Batterie < ${SEUIL_BATTERIE}% → mode ÉCO"
        sauvegarder_etat_saver
        activer_powersave
        return 1
    fi
    return 0
}

# ═══════════════════════════════════════════════════════════════════════════
# MODULE GPU
# ═══════════════════════════════════════════════════════════════════════════

gpu_disponible() {
    have nvidia-smi
}

afficher_gpu() {
    if ! gpu_disponible; then
        log_warn "nvidia-smi absent — pas de GPU NVIDIA"
        return 1
    fi

    local info
    info=$(nvidia-smi --query-gpu=name,driver_version,memory.total,power.draw,temperature.gpu,utilization.gpu \
                      --format=csv,noheader 2>/dev/null | head -1)

    if [ -z "$info" ]; then
        log_warn "nvidia-smi présent mais aucune donnée"
        return 1
    fi

    IFS=',' read -r nom driver mem puiss temp util <<< "$info"
    printf "  GPU       :%s\n" "$nom"
    printf "  Driver    :%s\n" "$driver"
    printf "  VRAM      :%s\n" "$mem"
    printf "  Puissance :%s\n" "$puiss"
    printf "  Temp      :%s\n" "$temp"
    printf "  Util      :%s\n" "$util"
    return 0
}

gpu_watts() {
    if ! gpu_disponible; then
        echo "0"; return
    fi
    nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' '
}

gpu_temp() {
    if ! gpu_disponible; then
        echo "0"; return
    fi
    nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' '
}

gpu_memory_used() {
    if ! gpu_disponible; then
        echo "0"; return
    fi
    nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' '
}

