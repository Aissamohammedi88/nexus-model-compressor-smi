ecrire_cuda() {
    local N=$N_ITERATIONS
    local E=$CONSTANTE_E
    local PI=$CONSTANTE_PI

    cat > calc.cu << ENDCUDA
#include <stdio.h>
#include <cuda_runtime.h>

__global__ void somme_kernel(float *r, float c, int n) {
    int i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i < n) atomicAdd(r, c / (float)(i + 1));
}

int main() {
    int n = $N;
    float *d_somme, h_somme = 0.0f;
    cudaMalloc(&d_somme, sizeof(float));
    cudaMemcpy(d_somme, &h_somme, sizeof(float), cudaMemcpyHostToDevice);

    cudaEvent_t start, stop;
    cudaEventCreate(&start);
    cudaEventCreate(&stop);
    cudaEventRecord(start);

    int threads = 256;
    int blocks = (n + threads - 1) / threads;
    somme_kernel<<<blocks, threads>>>(d_somme, ${E}f, n);
    cudaDeviceSynchronize();

    cudaEventRecord(stop);
    cudaEventSynchronize(stop);
    float ms = 0.0f;
    cudaEventElapsedTime(&ms, start, stop);

    cudaMemcpy(&h_somme, d_somme, sizeof(float), cudaMemcpyDeviceToHost);

    printf("CUDA   : n=%d  blocks=%d  threads=%d\n", n, blocks, threads);
    printf("         somme=%.6f\n", h_somme);
    printf("         temps=%.2f ms (GPU)\\n", ms);

    cudaFree(d_somme);
    return 0;
}
ENDCUDA
    log_ok "calc.cu écrit"
}

