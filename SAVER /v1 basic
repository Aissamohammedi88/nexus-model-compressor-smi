    local duree_total

    cap_fin=$(battery_capacity)
    gpu_w=$(gpu_watts)
    gpu_t=$(gpu_temp)
    watts_start=${BENCH_START_WATTS:-0}
    watts_end=$(battery_power_watts)

    duree_total=$(( $(now_epoch) - BENCH_START_EPOCH ))

    log_title "Rapport final"

    log_info "Durée totale     : ${duree_total}s"
    log_info "Batterie début   : ${BENCH_START_CAP:-?}%"
    log_info "Batterie fin     : ${cap_fin:-?}%"
    log_info "Watts début      : ${watts_start} W"
    log_info "Watts fin        : ${watts_end:-0} W"
    [ -n "$gpu_w" ] && [ "$gpu_w" != "0" ] && log_info "GPU watts        : ${gpu_w} W"
    [ -n "$gpu_t" ] && [ "$gpu_t" != "0" ] && log_info "GPU temp         : ${gpu_t}°C"

    local economie_watts=0
    if [ -n "$watts_start" ] && [ -n "$watts_end" ] && [ "$watts_start" != "0" ]; then
        economie_watts=$(awk -v a="$watts_start" -v b="$watts_end" 'BEGIN{printf "%.2f", a-b}')
        log_info "Économie watts   : ${economie_watts} W"
    fi

    cat > "$REPORT_FILE" << ENDJSON
{
  "version": "$VERSION",
  "auteur": "$AUTEUR",
  "licence": "$LICENCE",
  "timestamp": "$(now_ts)",
  "duree_secondes": $duree_total,
  "batterie_debut_pct": ${BENCH_START_CAP:-0},
  "batterie_fin_pct": ${cap_fin:-0},
  "watts_debut": ${watts_start:-0},
  "watts_fin": ${watts_end:-0},
  "economie_watts": $economie_watts,
  "gpu_watts": ${gpu_w:-0},
  "gpu_temp_c": ${gpu_t:-0},
  "n_iterations": $N_ITERATIONS,
  "constante_e": $CONSTANTE_E,
  "constante_pi": $CONSTANTE_PI,
  "config": "config.json"
}
ENDJSON

    log_ok "Rapport JSON : $REPORT_FILE"
    log_ok "Log complet  : $LOG_FILE"

    if have jq; then
        log_sep
        log_info "Rapport formaté (jq) :"
        jq . "$REPORT_FILE" 2>/dev/null || cat "$REPORT_FILE"
    fi
}

