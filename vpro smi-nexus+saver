# ═══════════════════════════════════════════════════════════════════════════
# UTILITAIRES
# ═══════════════════════════════════════════════════════════════════════════

have() { command -v "$1" >/dev/null 2>&1; }
now_ts()    { date '+%Y-%m-%d %H:%M:%S'; }
now_epoch() { date +%s; }

format_number() {
    printf "%'.0f" "$1" 2>/dev/null || echo "$1"
}

human_bytes() {
    local b=$1
    if [ "$b" -lt 1024 ]; then echo "${b} o"
    elif [ "$b" -lt 1048576 ]; then echo "$((b / 1024)) Ko"
    elif [ "$b" -lt 1073741824 ]; then echo "$((b / 1048576)) Mo"
    else echo "$((b / 1073741824)) Go"; fi
}

safe_mkdir() {
    [ -d "$1" ] || mkdir -p "$1" 2>/dev/null || return 1
    return 0
}

extract_json_number() {
    local file="$1" key="$2"
    [ ! -f "$file" ] && { echo ""; return; }
    grep -o "\"$key\"[[:space:]]*:[[:space:]]*[0-9.]*" "$file" 2>/dev/null \
        | head -1 | sed 's/.*:[[:space:]]*//'
}

extract_json_string() {
    local file="$1" key="$2"
    [ ! -f "$file" ] && { echo ""; return; }
    grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$file" 2>/dev/null \
        | head -1 | sed 's/.*:[[:space:]]*"//' | sed 's/"$//'
}

# ═══════════════════════════════════════════════════════════════════════════
# MODULE NEXUS SMI — Driver custom (remplace nvidia-smi)
# ═══════════════════════════════════════════════════════════════════════════

smi_init() {
    safe_mkdir "$SMI_DIR" || true
    SMI_JSON="$SMI_DIR/smi_last.json"
    log_smi "Driver Nexus SMI initialisé"
    log_smi "Répertoire : $SMI_DIR"
}

smi_detect_gpu_vendor() {
    # Détecte le vendor GPU via lspci
    if ! have lspci; then
        echo "unknown"
        return
    fi

    local info
    info=$(lspci 2>/dev/null | grep -iE 'vga|3d|display' | head -1)

    if echo "$info" | grep -qi "nvidia"; then
        echo "nvidia"
    elif echo "$info" | grep -qi "amd\|radeon\|advanced micro"; then
        echo "amd"
    elif echo "$info" | grep -qi "intel"; then
        echo "intel"
    else
        echo "unknown"
    fi
}

smi_detect_gpu_name() {
    if have lspci; then
        lspci 2>/dev/null | grep -iE 'vga|3d|display' | head -1 \
            | sed 's/.*: //' | sed 's/ (rev.*//'
    else
        echo "GPU inconnu"
    fi
}

smi_detect_driver() {
    # Détecte le driver actif
    if have nvidia-smi; then
        echo "nvidia-proprietary"
        return
    fi

    if [ -d /sys/module/nvidia ]; then
        echo "nvidia-kernel"
        return
    fi

    if [ -d /sys/module/amdgpu ]; then
        echo "amdgpu"
        return
    fi

    if [ -d /sys/module/i915 ]; then
        echo "i915-intel"
        return
    fi

    if [ -d /sys/module/radeon ]; then
        echo "radeon-legacy"
        return
    fi

    if [ -d /sys/module/nouveau ]; then
        echo "nouveau-open"
        return
    fi

    echo "unknown"
}

smi_read_gpu_temp() {
    # Lit la température GPU depuis /sys
    local temp_file
    for temp_file in /sys/class/hwmon/hwmon*/temp1_input; do
        [ -r "$temp_file" ] || continue
        local name
        name=$(cat "${temp_file%temp1_input}name" 2>/dev/null)
        case "$name" in
            *amdgpu*|*nouveau*|*nvidia*|*radeon*|*i915*)
                local v
                v=$(cat "$temp_file" 2>/dev/null)
                if [ -n "$v" ]; then
                    echo $((v / 1000))
                    return
                fi
                ;;
        esac
    done
    echo "0"
}

smi_read_gpu_freq() {
    # Fréquence GPU courante
    for f in /sys/class/drm/card*/device/pp_dpm_sclk \
             /sys/class/drm/card*/gt_cur_freq_mhz; do
        [ -r "$f" ] || continue
        local v
        v=$(cat "$f" 2>/dev/null | head -1)
        if [ -n "$v" ]; then
            echo "$v"
            return
        fi
    done
    echo "0"
}

smi_read_gpu_mem() {
    # VRAM utilisée / totale
    local used=0 total=0

    for f in /sys/class/drm/card*/device/mem_info_vram_used; do
        [ -r "$f" ] || continue
        used=$(cat "$f" 2>/dev/null)
        break
    done

    for f in /sys/class/drm/card*/device/mem_info_vram_total; do
        [ -r "$f" ] || continue
        total=$(cat "$f" 2>/dev/null)
        break
    done

    if [ -n "$used" ] && [ -n "$total" ] && [ "$total" -gt 0 ]; then
        echo "$used $total"
    else
        echo "0 0"
    fi
}

smi_read_gpu_load() {
    # Charge GPU en %
    for f in /sys/class/drm/card*/device/gpu_busy_percent; do
        [ -r "$f" ] || continue
        cat "$f" 2>/dev/null
        return
    done
    echo "0"
}

smi_read_gpu_power() {
    # Puissance GPU
    for f in /sys/class/drm/card*/device/hwmon/hwmon*/power1_average \
             /sys/class/drm/card*/device/power1_average; do
        [ -r "$f" ] || continue
        local v
        v=$(cat "$f" 2>/dev/null)
        if [ -n "$v" ]; then
            # micowatt vers watt
            echo $((v / 1000000))
            return
        fi
    done
    echo "0"
}

smi_read_cpu_temp() {
    # Temp CPU via hwmon ou thermal_zone
    for f in /sys/class/thermal/thermal_zone*/temp; do
        [ -r "$f" ] || continue
        local v
        v=$(cat "$f" 2>/dev/null)
        if [ -n "$v" ] && [ "$v" -gt 0 ]; then
            echo $((v / 1000))
            return
        fi
    done
    echo "0"
}

smi_read_cpu_freq() {
    local f=/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq
    if [ -r "$f" ]; then
        local v
        v=$(cat "$f" 2>/dev/null)
        echo $((v / 1000))
    else
        echo "0"
    fi
}

smi_read_ram() {
    if [ -r /proc/meminfo ]; then
        awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{printf "%d %d", (t-a), t}' /proc/meminfo
    else
        echo "0 0"
    fi
}

smi_read_disque() {
    if [ -d / ]; then
        df -k / 2>/dev/null | tail -1 | awk '{print $3, $2}'
    else
        echo "0 0"
    fi
}

smi_read_uptime() {
    if [ -r /proc/uptime ]; then
        awk '{print int($1)}' /proc/uptime
    else
        echo "0"
    fi
}

smi_scan_complet() {
    # Scan complet et retourne un JSON
    local vendor name driver
    local gpu_temp gpu_freq gpu_load gpu_power
    local mem_used mem_total
    local cpu_temp cpu_freq
    local ram_used ram_total
    local disk_used disk_total
    local uptime_s

    vendor=$(smi_detect_gpu_vendor)
    name=$(smi_detect_gpu_name)
    driver=$(smi_detect_driver)
    gpu_temp=$(smi_read_gpu_temp)
    gpu_freq=$(smi_read_gpu_freq)
    gpu_load=$(smi_read_gpu_load)
    gpu_power=$(smi_read_gpu_power)
    read -r mem_used mem_total <<< "$(smi_read_gpu_mem)"
    cpu_temp=$(smi_read_cpu_temp)
    cpu_freq=$(smi_read_cpu_freq)
    read -r ram_used ram_total <<< "$(smi_read_ram)"
    read -r disk_used disk_total <<< "$(smi_read_disque)"
    uptime_s=$(smi_read_uptime)

    cat > "$SMI_JSON" << ENDJSON
{
  "version": "$VERSION",
  "driver": "Nexus SMI",
  "auteur": "$AUTEUR",
  "timestamp": "$(now_ts)",
  "gpu": {
    "vendor": "$vendor",
    "name": "$name",
    "driver_kernel": "$driver",
    "temperature_c": $gpu_temp,
    "frequence_mhz": "$gpu_freq",
    "charge_pct": $gpu_load,
    "puissance_w": $gpu_power,
    "vram_used_bytes": $mem_used,
    "vram_total_bytes": $mem_total
  },
  "cpu": {
    "temperature_c": $cpu_temp,
    "frequence_mhz": $cpu_freq
  },
  "ram": {
    "used_kb": $ram_used,
    "total_kb": $ram_total
  },
  "disque": {
    "used_kb": $disk_used,
    "total_kb": $disk_total
  },
  "uptime_seconds": $uptime_s
}
ENDJSON
}

smi_afficher() {
    log_title "Nexus SMI — Monitoring système"

    smi_scan_complet

    local vendor name driver
    local gpu_temp gpu_freq gpu_load gpu_power
    local mem_used mem_total
    local cpu_temp cpu_freq
    local ram_used ram_total
    local disk_used disk_total
    local uptime_s

    vendor=$(smi_detect_gpu_vendor)
    name=$(smi_detect_gpu_name)
    driver=$(smi_detect_driver)
    gpu_temp=$(smi_read_gpu_temp)
    gpu_freq=$(smi_read_gpu_freq)
    gpu_load=$(smi_read_gpu_load)
    gpu_power=$(smi_read_gpu_power)
    read -r mem_used mem_total <<< "$(smi_read_gpu_mem)"
    cpu_temp=$(smi_read_cpu_temp)
    cpu_freq=$(smi_read_cpu_freq)
    read -r ram_used ram_total <<< "$(smi_read_ram)"
    read -r disk_used disk_total <<< "$(smi_read_disque)"
    uptime_s=$(smi_read_uptime)

    log_smi "GPU Vendor  : $vendor"
    log_smi "GPU Name    : $name"
    log_smi "GPU Driver  : $driver"
    log_smi "GPU Temp    : ${gpu_temp}°C"
    log_smi "GPU Freq    : ${gpu_freq} MHz"
    log_smi "GPU Charge  : ${gpu_load}%"
    log_smi "GPU Power   : ${gpu_power} W"

    if [ "$mem_total" -gt 0 ]; then
        local used_mb=$((mem_used / 1048576))
        local total_mb=$((mem_total / 1048576))
        log_smi "VRAM        : ${used_mb} / ${total_mb} Mo"
    else
        log_smi "VRAM        : indisponible"
    fi

    log_smi "CPU Temp    : ${cpu_temp}°C"
    log_smi "CPU Freq    : ${cpu_freq} MHz"

    if [ "$ram_total" -gt 0 ]; then
        local used_mb=$((ram_used / 1024))
        local total_mb=$((ram_total / 1024))
        log_smi "RAM         : ${used_mb} / ${total_mb} Mo"
    fi

    if [ "$disk_total" -gt 0 ]; then
        local used_gb=$((disk_used / 1048576))
        local total_gb=$((disk_total / 1048576))
        log_smi "Disque /    : ${used_gb} / ${total_gb} Go"
    fi

    log_smi "Uptime      : $((uptime_s / 3600))h $(((uptime_s % 3600) / 60))m"
    log_smi "JSON        : $SMI_JSON"

    return 0
}

smi_watch() {
    # Monitoring continu
    local intervalle="${1:-5}"
    log_title "Nexus SMI — Watch mode (Ctrl+C pour arrêter)"
    log_info "Intervalle : ${intervalle}s"
    echo ""

    while true; do
        clear
        printf "${BG_CYAN}${BOLD} NEXUS SMI ${N} — $(now_ts)\n\n"
        smi_afficher
        sleep "$intervalle"
    done
}

# ═══════════════════════════════════════════════════════════════════════════
# MODULE BATTERIE
# ═══════════════════════════════════════════════════════════════════════════

battery_path() {
    local bat
    bat=$(ls /sys/class/power_supply/ 2>/dev/null | grep -i '^BAT' | head -1)
    [ -n "$bat" ] && echo "/sys/class/power_supply/$bat"
}

battery_capacity() {
    local p; p=$(battery_path)
    [ -n "$p" ] && [ -r "$p/capacity" ] && cat "$p/capacity" 2>/dev/null
}

battery_status() {
    local p; p=$(battery_path)
    [ -n "$p" ] && [ -r "$p/status" ] && cat "$p/status" 2>/dev/null
}

battery_voltage() {
    local p; p=$(battery_path)
    if [ -n "$p" ] && [ -r "$p/voltage_now" ]; then
        local v; v=$(cat "$p/voltage_now" 2>/dev/null)
        echo $((v / 1000))
    fi
}

battery_current() {
    local p; p=$(battery_path)
    if [ -n "$p" ] && [ -r "$p/current_now" ]; then
        local c; c=$(cat "$p/current_now" 2>/dev/null)
        echo $((c / 1000))
    fi
}

battery_health() {
    local p; p=$(battery_path)
    [ -n "$p" ] && [ -r "$p/health" ] && cat "$p/health" 2>/dev/null
}

battery_cycles() {
    local p; p=$(battery_path)
    [ -n "$p" ] && [ -r "$p/cycle_count" ] && cat "$p/cycle_count" 2>/dev/null
}

battery_power_watts() {
    local v c
    v=$(battery_voltage); c=$(battery_current)
    if [ -n "$v" ] && [ -n "$c" ] && [ "$v" -gt 0 ]; then
        awk -v v="$v" -v c="$c" 'BEGIN{printf "%.2f", (v*c)/1000000}'
    fi
}

afficher_batterie() {
    local cap sta v c p h cyc
    cap=$(battery_capacity); sta=$(battery_status)
    v=$(battery_voltage); c=$(battery_current)
    p=$(battery_power_watts); h=$(battery_health); cyc=$(battery_cycles)

    if [ -z "$cap" ]; then
        log_warn "Batterie introuvable (desktop ou VM)"
        return 1
    fi

    printf "  Capacité : %s%%\n" "$cap"
    printf "  Statut   : %s\n" "${sta:-?}"
    [ -n "$v" ] && printf "  Tension  : %s mV\n" "$v"
    [ -n "$c" ] && printf "  Courant  : %s mA\n" "$c"
    [ -n "$p" ] && printf "  Puissance: %s W\n" "$p"
    [ -n "$h" ] && printf "  Santé    : %s\n" "$h"
    [ -n "$cyc" ] && printf "  Cycles   : %s\n" "$cyc"

    if [ "$cap" -lt "$SEUIL_BATTERIE" ] && [ "$sta" != "Charging" ]; then
        log_warn "Batterie faible (< ${SEUIL_BATTERIE}%)"
        return 2
    fi
    return 0
}

# ═══════════════════════════════════════════════════════════════════════════
# MODULE BATTERY SAVER
# ═══════════════════════════════════════════════════════════════════════════

SAVER_STATE_FILE="/tmp/nexus_saver_state_$$"

sauvegarder_etat_saver() {
    : > "$SAVER_STATE_FILE"
    local cpu_gov
    cpu_gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "")
    echo "CPU_GOV=$cpu_gov" >> "$SAVER_STATE_FILE"

    local screen_bright=""
    if have xrandr; then
        screen_bright=$(xrandr --verbose 2>/dev/null | grep -i brightness | head -1 | awk '{print $2}')
    fi
    [ -n "$screen_bright" ] && echo "BRIGHT=$screen_bright" >> "$SAVER_STATE_FILE"

    if have rfkill; then
        local bt_state
        bt_state=$(rfkill list bluetooth 2>/dev/null | grep -i "soft blocked" | head -1 | grep -c "yes" || echo "0")
        echo "BT_BLOCKED=$bt_state" >> "$SAVER_STATE_FILE"

        local wifi_state
        wifi_state=$(rfkill list wifi 2>/dev/null | grep -i "soft blocked" | head -1 | grep -c "yes" || echo "0")
        echo "WIFI_BLOCKED=$wifi_state" >> "$SAVER_STATE_FILE"
    fi
}

activer_powersave() {
    log_step "Activation mode POWERSAVE"

    if have cpupower; then
        sudo cpupower frequency-set -g powersave >/dev/null 2>&1 && \
            log_ok "CPU governor → powersave" || log_warn "cpupower échoué"
    elif [ -w /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
        echo powersave | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 && \
            log_ok "CPU governor → powersave (direct)" || log_warn "Écriture échouée"
    fi

    if have tlp; then
        sudo tlp bat >/dev/null 2>&1 && log_ok "TLP mode battery" || true
    fi

    if [ -w /sys/class/backlight/*/brightness ]; then
        for bl in /sys/class/backlight/*/brightness; do
            local maxb
            maxb=$(cat "${bl%brightness}max_brightness" 2>/dev/null)
            if [ -n "$maxb" ] && [ "$maxb" -gt 0 ]; then
                local target=$((maxb * 35 / 100))
                echo "$target" | sudo tee "$bl" >/dev/null 2>&1 && \
                    log_ok "Luminosité → 35%" || true
            fi
        done
    fi

    if have rfkill; then
        sudo rfkill block bluetooth 2>/dev/null && log_ok "Bluetooth bloqué" || true
    fi
}

restaurer_etat() {
    log_step "Restauration état initial"

    if [ -f "$SAVER_STATE_FILE" ]; then
        local cpu_gov bright bt_blocked wifi_blocked
        cpu_gov=$(grep "^CPU_GOV=" "$SAVER_STATE_FILE" | cut -d= -f2)
        if [ -n "$cpu_gov" ]; then
            if have cpupower; then
                sudo cpupower frequency-set -g "$cpu_gov" >/dev/null 2>&1 || true
            else
                echo "$cpu_gov" | sudo tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor >/dev/null 2>&1 || true
            fi
            log_ok "CPU governor → $cpu_gov"
        fi

        bright=$(grep "^BRIGHT=" "$SAVER_STATE_FILE" | cut -d= -f2)
        if [ -n "$bright" ]; then
            for bl in /sys/class/backlight/*/brightness; do
                echo "$bright" | sudo tee "$bl" >/dev/null 2>&1 || true
            done
            log_ok "Luminosité → $bright"
        fi

        bt_blocked=$(grep "^BT_BLOCKED=" "$SAVER_STATE_FILE" | cut -d= -f2)
        if [ "$bt_blocked" = "0" ] && have rfkill; then
            sudo rfkill unblock bluetooth 2>/dev/null && log_ok "Bluetooth rétabli" || true
        fi

        wifi_blocked=$(grep "^WIFI_BLOCKED=" "$SAVER_STATE_FILE" | cut -d= -f2)
        if [ "$wifi_blocked" = "0" ] && have rfkill; then
            sudo rfkill unblock wifi 2>/dev/null && log_ok "Wi-Fi rétabli" || true
        fi
    fi

    if have tlp; then
        sudo tlp start >/dev/null 2>&1 || true
    fi

    rm -f "$SAVER_STATE_FILE" 2>/dev/null
}

battery_saver_auto() {
    local cap
    cap=$(battery_capacity)
    [ -z "$cap" ] && return 0

    if [ "$cap" -lt "$SEUIL_BATTERIE_ULTRA" ]; then
        log_alert "Batterie < ${SEUIL_BATTERIE_ULTRA}% → mode ULTRA"
        sauvegarder_etat_saver
        activer_powersave
        return 2
    elif [ "$cap" -lt "$SEUIL_BATTERIE" ]; then
        log_warn "Batterie < ${SEUIL_BATTERIE}% → mode ÉCO"
        sauvegarder_etat_saver
        activer_powersave
        return 1
    fi
    return 0
}

