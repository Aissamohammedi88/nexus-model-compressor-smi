# MODULE GOOGLE BREACH TEST
# ═══════════════════════════════════════════════════════════════════════════

breach_test_google() {
    log_title "Google Breach Test"
    log_info "Vérification des connexions sortantes vers Google..."

    local total=0 suspects=0

    if have ss || have netstat; then
        local cmd="ss -tnp"
        have ss || cmd="netstat -tnp"

        local connexions
        connexions=$($cmd 2>/dev/null | grep ESTAB | head -100)

        while IFS= read -r ligne; do
            [ -z "$ligne" ] && continue
            total=$((total + 1))
            if echo "$ligne" | grep -qiE "google|goog|gstatic|googleapis|1e100|ggpht|gvt1|youtube"; then
                suspects=$((suspects + 1))
                log_warn "$ligne"
            fi
        done <<< "$connexions"
    fi

    log_sep
    log_info "Total connexions analysées : $total"
    [ "$suspects" -gt 0 ] && log_warn "$suspects connexion(s) Google" || log_ok "Aucune connexion Google"

    log_info "Test DNS :"
    if have getent; then
        for h in google.com www.google.com gstatic.com; do
            local r; r=$(getent hosts "$h" 2>/dev/null | head -1)
            [ -n "$r" ] && printf "  %-20s %s\n" "$h" "$r" || printf "  %-20s (non résolu)\n" "$h"
        done
    fi

    log_info "Ping Google :"
    if have ping; then
        ping -c 3 -W 1 google.com 2>/dev/null | tail -3 || log_warn "Ping échoué"
    fi

    log_ok "Breach test terminé"
}

