banniere() {
    clear
    echo ""
    printf "${P}╔═══════════════════════════════════════════════════════════╗${N}\n"
    printf "${P}║${N}  ${C}${BOLD}NEXUS CUDA MATH BENCH${N} v${VERSION}                     ${P}║${N}\n"
    printf "${P}║${N}  Auteur  : ${AUTEUR}                    ${P}║${N}\n"
    printf "${P}║${N}  Licence : ${LICENCE}                          ${P}║${N}\n"
    printf "${P}╚═══════════════════════════════════════════════════════════╝${N}\n"
    echo ""
    printf "${D}  Java + Rust + Python + C++ + JavaScript + Go + CUDA${N}\n"
    printf "${D}  + Nexus SMI custom + Battery Saver + Google Breach${N}\n"
    echo ""
    printf "${Y}${BOLD}  WALLAH DGK — CETTE OEUVRE EST MONSTRUEUSE 🔥${N}\n"
    echo ""
}

# ═══════════════════════════════════════════════════════════════════════════
# MAIN
# ═══════════════════════════════════════════════════════════════════════════

main() {
    banniere
    trap trap_cleanup INT TERM

    preparer_dir
    smi_init
    ecrire_json_config
    ecrire_java
    ecrire_rust
    ecrire_python
    ecrire_cpp
    ecrire_js
    ecrire_go
    ecrire_cuda

    echo ""
    log_title "Système"
    afficher_systeme

    echo ""
    log_title "Batterie"
    afficher_batterie

    echo ""
    smi_afficher

    echo ""
    log_title "Outils"
    outils_disponibles

    battery_saver_auto

    demarrer_benchmark

    if [ "${1:-}" = "auto" ]; then
        lancer_tous
        [ "${2:-}" = "breach" ] && breach_test_google
        generer_rapport
        nettoyer
        exit 0
    fi

    if [ "${1:-}" = "test" ]; then
        lancer_rapide
        generer_rapport
        nettoyer
        exit 0
    fi

    if [ "${1:-}" = "smi" ]; then
        smi_afficher
        exit 0
    fi

    if [ "${1:-}" = "watch" ]; then
        smi_watch "${2:-5}"
        exit 0
    fi

    while true; do
        echo ""
        afficher_menu
        read -r choix
        case "$choix" in
            1) lancer_tous ;;
            2) lancer_rapide ;;
            3) lancer_gpu_only ;;
            4) echo ""; afficher_batterie ;;
            5) echo ""; smi_afficher ;;
            6) echo ""; smi_watch 5 ;;
            7) echo ""; afficher_systeme ;;
            8) echo ""; outils_disponibles ;;
            9) echo ""; sauvegarder_etat_saver; activer_powersave ;;
            10) echo ""; restaurer_etat ;;
            11) echo ""; breach_test_google ;;
            12)
                lancer_tous
                echo ""
                smi_afficher
                echo ""
                breach_test_google
                generer_rapport
                ;;
            0)
                generer_rapport
                nettoyer
                log_success "Terminé."
                exit 0
                ;;
            *) log_err "Choix invalide" ;;
        esac
    done
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo ""
    echo "Usage: $0 [auto|test|smi|watch|breach|--help]"
    echo ""
    echo "  auto      Benchmark complet automatique"
    echo "  auto breach  Benchmark + Google Breach Test"
    echo "  test      Benchmark rapide (Python + JS)"
    echo "  smi       Nexus SMI (scan seul)"
    echo "  watch N   Nexus SMI monitoring continu (N=intervalle en s)"
    echo "  breach    Google Breach Test seul"
    echo "  (rien)    Menu interactif"
    echo ""
    exit 0
fi

if [ "${1:-}" = "breach" ]; then
    banniere
    breach_test_google
    exit 0
fi

main "${1:-}"
